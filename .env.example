# FinSight Environment Configuration
# Copy this file to .env and fill in your values.

# --- NVIDIA NIM API (Required for RAG + LangGraph) ---
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override default models
# NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# --- SEC EDGAR (Required) ---
# Must include a company name and contact email per SEC policy
SEC_USER_AGENT=FinSight your-email@example.com

# --- Optional overrides ---
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=5
# FORECAST_LOOKBACK_YEARS=5
